yan"], ["蓝色", "blue"], ["紫色", "purple"], ["自定义颜色（面板设置）", "custom"]]}], "previousStatement": null, "nextStatement": null, "inputsInline": true, "colour": "#22c55e", "tooltip": "云台自动转动，把目标保持在画面中心"}}, {"type": "track_stop", "category": "sense", "blockly": {"type": "track_stop", "message0": "停止追踪", "previousStatement": null, "nextStatement": null, "colour": "#22c55e", "tooltip": "停止云台自动追踪"}}, {"type": "wait", "category": "control", "blockly": {"type": "wait", "message0": "等待 %1 秒", "args0": [{"type": "field_number", "name": "SECONDS", "value": 1, "min": 0, "max": 600, "precision": 0.1}], "previousStatement": null, "nextStatement": null, "colour": "#f97316", "tooltip": "等待一段时间"}}, {"type": "wait_until", "category": "control", "blockly": {"type": "wait_until", "message0": "等到看到 %1，最多 %2 秒", "args0": [{"type": "field_dropdown", "name": "TARGET", "options": [["人脸", "face"], ["网球", "tennis"], ["红色", "red"], ["橙色", "orange"], ["黄色", "yellow"], ["绿色", "green"], ["青色", "cyan"], ["蓝色", "blue"], ["紫色", "purple"], ["自定义颜色（面板设置）", "custom"], ["手势·拳头", "gesture:fist"], ["手势·一根手指", "gesture:one"], ["手势·剪刀手", "gesture:peace"], ["手势·三根手指", "gesture:three"], ["手势·四根手指", "gesture:four"], ["手势·张开手掌", "gesture:open"], ["手势·点赞", "gesture:thumbs_up"], ["手势·踩", "gesture:thumbs_down"], ["手势·OK 手势", "gesture:ok"]]}, {"type": "field_number", "name": "TIMEOUT", "value": 5, "min": 0.5, "max": 60, "precision": 0.5}], "previousStatement": null, "nextStatement": null, "inputsInline": true, "colour": "#f97316", "tooltip": "一直等到看见目标再继续；超时后继续执行下一块"}}, {"type": "repeat", "category": "control", "blockly": {"type": "repeat", "message0": "重复 %1 次 %2", "args0": [{"type": "field_number", "name": "TIMES", "value": 3, "min": 1, "max": 100, "precision": 1}, {"type": "input_statement", "name": "DO"}], "previousStatement": null, "nextStatement": null, "colour": "#f97316", "tooltip": "重复执行里面的积木"}}, {"type": "forever", "category": "control", "blockly": {"type": "forever", "message0": "一直重复 %1", "args0": [{"type": "input_statement", "name": "DO"}], "previousStatement": null, "nextStatement": null, "colour": "#f97316", "tooltip": "一直重复执行，直到点击停止"}}], "colors": [{"key": "red", "label": "红色"}, {"key": "orange", "label": "橙色"}, {"key": "yellow", "label": "黄色"}, {"key": "green", "label": "绿色"}, {"key": "cyan", "label": "青色"}, {"key": "blue", "label": "蓝色"}, {"key": "purple", "label": "紫色"}, {"key": "custom", "label": "自定义颜色（面板设置）"}]}}